managed implementation in class zbp_r_incident_088 unique;
strict ( 2 );
with draft;


// ************** INCIDENT ***************** //
define behavior for Z_R_INCIDENT_088 alias Incident
persistent table zdt_inct_088
draft table zdt_inctd_088
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global, instance )
{

  create ( authorization : global );
  update;
  delete;

  // se asocia a la vista  History y se permite crear registros dependiendo de la vista padre(Incident) y se activa el draft "borrador"
  association _History { create ( features : instance ); with draft; }

  // se le asigna un valor automatico incrmental en el IncUuid por cada registro creado
  field ( numbering : managed, readonly ) IncUuid;

  //campos obligatorios al crear o editar un registro
  field ( mandatory )
  title,
  description,
  priority,
  Status;

  //campos solo lectura
  field ( readonly )
  IncidentId,
  CreationDate,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;



  //  ****** ACCIONES ******

  // boton de accion ChangeStatus: cambia el status de la instancia que estamos visualizando en el detalle
  action ( features : instance, authorization : update ) ChangeStatus parameter z_a_ChangeStatus_088 result [1] $self;

  // acción interna que llamada por la determinación (new_record_history) para crear un regsitro a la vista History
  internal action new_record;




  //  ****** VALIDACIONES ******

  // validar campos obligatorios al crear o editar un registro y que muestre mensaje de error
  validation validate_required_fields on save { create; update; field Title, Description, Priority, Status, CreationDate; }

  // validar que el campo ChangedDate sea una fecha posterior a la de CreationDate
  validation validate_range_dates on save { create; update; field CreationDate, ChangedDate; }

  // validación el Status al guardar
  // si el Status cambia a InProgress(IP), debe asignarse un responsable
  // solo el usuario asignado o un administrador pueden cambiar el estado de un incidente.
  validation validate_change_status on save { field status; }

  // validar en el boton "Delete" que si la incidencia esta con Status Open(OP) no se puede eliminar
  validation validate_status_op on save { delete; }




  //  ****** DETERMINACIONES ******

  // se asigna un nº secuencial al IncidentId, Status= 'OP' y CreationDate al crear un registro
  determination set_inital_values on modify { create; }

  // se crea un nuevo registro a la vista History en el mísmo momento que se crea un registro para la vista Incident
  // llama a la acción (new_record) para crear un registro nuevo a la BBDD de la vista History
  determination new_record_history on save { create; }



  //  ****** SIDE EFFECTS ******

  // actualiza el fronted de la vista hija History despues de ejecutar el boton ChangeStatus
  side effects { action ChangeStatus affects entity _History; }


  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  draft action Edit;


  draft determine action Prepare
  {
    validation validate_required_fields;
    validation validate_range_dates;
    validation validate_change_status;
    validation validate_status_op;
  }

  mapping for zdt_inct_088
    {
      IncUuid            = inc_uuid;
      IncidentId         = incident_id;
      Title              = title;
      Description        = description;
      Status             = status;
      Priority           = priority;
      CreationDate       = creation_date;
      ChangedDate        = changed_date;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}




// ************** HISTORY ***************** //
define behavior for Z_R_history_088 alias History
persistent table zdt_inct_h_088
draft table zdt_inctd_h_088
lock dependent by _Incident
authorization dependent by _Incident
etag master LocalLastChangedAt

{

  update;
  delete;

  association _Incident;

  // se le asigna un valor automatico incrmental en el HisUuid por cada registro creado
  field ( numbering : managed, readonly ) HisUuid;

  field ( readonly )
  IncUuid,
  PreviousStatus,
  NewStatus,
  Text,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;


  mapping for zdt_inct_h_088
    {
      HisUUID            = his_uuid;
      IncUUID            = inc_uuid;
      HisID              = his_id;
      PreviousStatus     = previous_status;
      NewStatus          = new_status;
      Text               = text;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }
}